{
  "manifest_version": 3,
  "name": "Figloo",
  "version": "0.5.0",
  "description": "Lets a local coding agent explore the Figma design around your current selection.",
  "minimum_chrome_version": "116",
  "key": "",
  "icons": {
    "16": "icons/color-16.png",
    "32": "icons/color-32.png",
    "48": "icons/color-48.png",
    "128": "icons/color-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/gray-16.png",
      "32": "icons/gray-32.png"
    },
    "default_title": "Figloo: no Figma design file in this tab"
  },
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.figma.com/design/*",
        "https://www.figma.com/file/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
